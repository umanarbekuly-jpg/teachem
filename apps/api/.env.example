NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://tutor:change-local-database-password@localhost:5432/tutor?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
PUBLIC_ORIGIN=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tutor-private
S3_ACCESS_KEY=tutorstorage
S3_SECRET_KEY=change-local-storage-password
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace-with-a-strong-password
