{
  "name": "tutor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tutor/api --filter @tutor/web dev",
    "build": "pnpm --filter @tutor/shared build && pnpm --filter @tutor/api build && pnpm --filter @tutor/web build",
    "typecheck": "pnpm --filter @tutor/shared build && pnpm -r typecheck",
    "lint": "eslint apps packages --max-warnings=0",
    "test": "pnpm --filter @tutor/api test",
    "test:e2e": "pnpm --filter @tutor/api test:e2e",
    "db:generate": "pnpm --filter @tutor/api db:generate",
    "db:migrate": "pnpm --filter @tutor/api db:migrate",
    "db:seed": "pnpm --filter @tutor/api db:seed",
    "api:generate": "pnpm --filter @tutor/api openapi && pnpm --filter @tutor/web api:generate"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "typescript": "~5.9.2"
  }
}
