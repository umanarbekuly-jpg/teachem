{
  "name": "tutor-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tutor/shared build && pnpm --filter @tutor/web dev",
    "dev:api": "go -C apps/api-go run ./cmd/server",
    "build": "pnpm build:api && pnpm build:web",
    "build:api": "go -C apps/api-go build ./cmd/server",
    "build:web": "pnpm --filter @tutor/shared build && pnpm --filter @tutor/web build",
    "lint": "eslint apps/web packages --max-warnings=0",
    "typecheck": "pnpm --filter @tutor/shared build && pnpm -r typecheck",
    "test": "go -C apps/api-go test -p 1 ./...",
    "test:e2e": "node scripts/test-go.cjs",
    "db:migrate": "go -C apps/api-go run ./cmd/server migrate",
    "db:seed": "go -C apps/api-go run ./cmd/server seed",
    "api:generate": "pnpm --filter @tutor/web api:generate"
  },
  "devDependencies": {
    "eslint": "^9.36.0",
    "typescript-eslint": "^8.44.0",
    "typescript": "~5.9.2"
  }
}
